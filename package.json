{
  "name": "bodybeats-studio",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "build": "tsc --noEmit && vite build --emptyOutDir false",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run test && npm run build",
    "format": "prettier --write src tests index.html",
    "preview": "vite preview --host 127.0.0.1 --port 4181 --strictPort"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
